{
  "name": "@recuidado/core",
  "version": "0.1.0",
  "private": true,
  "description": "Code shared by the API and the worker: env validation, database schema, doses queue, and the services both run (doses, voice call requests, alerts, push, e-mail, stock).",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@recuidado/telemetry": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "resend": "6.38.0",
    "web-push": "4.0.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "bullmq": "^6.7.3"
  },
  "devDependencies": {
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "bullmq": "^6.7.3",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "files": [
    "dist"
  ]
}
