{
  "name": "@recuidado/telemetry",
  "version": "0.1.0",
  "private": true,
  "description": "PostHog telemetry shared by the Node services: product events, exceptions, LLM generations and OTLP logs.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "posthog-node": "5.68.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "files": [
    "dist"
  ]
}
