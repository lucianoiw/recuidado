{
  "name": "@recuidado/prescription-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Reads a prescription photo with Claude and returns structured JSON (medication, strength, dosage, schedule).",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "read": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "fixtures:render": "tsx scripts/render-fixtures.ts",
    "eval": "tsx --env-file-if-exists=../../.env scripts/eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/caveat": "5.3.0",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
