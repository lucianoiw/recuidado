{
  "name": "@recuidado/data",
  "version": "0.1.0",
  "private": true,
  "description": "Downloads and cleans public data used by Recuidado: Farmácia Popular free items, CMED price ceilings and pharmacies of the demo region.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch:free-items": "tsx src/fetch-free-items.ts",
    "fetch:cmed": "tsx src/fetch-cmed.ts",
    "fetch:pharmacies": "tsx src/fetch-pharmacies.ts",
    "report:regions": "tsx src/report-regions.ts",
    "link:prices": "tsx src/link-free-items-prices.ts",
    "fetch:all": "pnpm fetch:free-items && pnpm fetch:cmed && pnpm fetch:pharmacies && pnpm link:prices",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
