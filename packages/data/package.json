{
  "name": "@recuidado/data",
  "version": "0.1.0",
  "private": true,
  "description": "Downloads and cleans public data used by Recuidado: Farmácia Popular free items, REMUME and CEAF lists, CMED price ceilings, pharmacies and SUS units of the demo region.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "fetch:free-items": "tsx src/fetch-free-items.ts",
    "fetch:cmed": "tsx src/fetch-cmed.ts",
    "fetch:pharmacies": "tsx src/fetch-pharmacies.ts",
    "fetch:remume": "tsx src/fetch-remume.ts",
    "fetch:ceaf": "tsx src/fetch-ceaf.ts",
    "fetch:sus-units": "tsx src/fetch-sus-units.ts",
    "fetch:remediosp": "tsx src/fetch-remediosp.ts",
    "report:regions": "tsx src/report-regions.ts",
    "link:prices": "tsx src/link-free-items-prices.ts",
    "link:free-access": "tsx src/link-free-access.ts",
    "build:programs": "tsx src/build-programs.ts",
    "build:curated-programs": "tsx src/build-curated-programs.ts",
    "report:coverage": "tsx src/report-coverage.ts",
    "fetch:all": "pnpm fetch:free-items && pnpm fetch:cmed && pnpm fetch:pharmacies && pnpm fetch:remume && pnpm fetch:ceaf && pnpm fetch:sus-units && pnpm fetch:remediosp && pnpm link:prices && pnpm link:free-access && pnpm build:programs && pnpm report:coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "files": [
    "dist",
    "seed"
  ]
}
