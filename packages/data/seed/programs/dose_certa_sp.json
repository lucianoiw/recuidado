{
  "program": {
    "id": "dose_certa_sp",
    "name": "Farmácia Dose Certa (Governo do Estado de São Paulo)",
    "kind": "free",
    "level": "state",
    "region": "3550308",
    "channel": "Nas Farmácias Dose Certa do Estado, de segunda a sexta, das 8h às 17h: metrô Ana Rosa, Brás, Clínicas, Corinthians-Itaquera, Santana, Saúde, Sé e Vila Mariana; CPTM Guaianazes e Santo Amaro; terminal São Mateus; hospitais Sapopemba, Pedreira, Santa Marcelina e Mandaqui.",
    "sourceUrl": "https://saude.sp.gov.br/ses/perfil/gestor/assistencia-farmaceutica/farmacia-dose-certa",
    "version": "2026-11-12",
    "documents": [
      "Receita do SUS do Estado de São Paulo, com o nome genérico do remédio",
      "Cartão do SUS"
    ],
    "rules": [
      {
        "kind": "note",
        "text": "A receita tem que ser do SUS e vale 180 dias para remédio de uso contínuo (30 dias para controlado, 10 para antibiótico)."
      },
      {
        "kind": "note",
        "text": "Receita particular só nas unidades Mandaqui, Pedreira, Guaianazes e Sé, com Cartão do SUS da cidade de São Paulo."
      }
    ]
  },
