# Copy to .env and fill in. Never commit real secrets.
# In production these are set as Coolify environment variables.

# --- api (apps/api) ---
PORT=4000
DATABASE_URL=postgres://recuidado:recuidado@localhost:5432/recuidado
REDIS_URL=redis://localhost:6379
# Comma-separated; each origin is also allowed with and without "www.".
WEB_URL=http://localhost:3000
# Voice service (apps/voice), called when a dose is not confirmed.
VOICE_URL=http://localhost:5000
VOICE_API_TOKEN=
DOSE_CALL_AFTER_MINUTES=15
DOSE_ALERT_AFTER_MINUTES=30
# Reminder calls in the last 24 hours: per family (demo family exempt) and in total. 0 turns calls off.
CALL_DAILY_LIMIT_PER_FAMILY=3
CALL_DAILY_LIMIT_TOTAL=20
# LGPD: days a call transcript is kept; after that only the outcome (took it or not) stays.
VOICE_TRANSCRIPT_RETENTION_DAYS=90
# "Perguntar à farmácia" (Onde comprar): the only number the pharmacy call dials. A phone the team
# controls, never a real pharmacy; it must also be listed one by one in CALL_ALLOWED_NUMBERS ("*" is not enough).
# Pharmacy calls count toward the CALL_DAILY_LIMIT_* above. Empty turns the button off.
PHARMACY_CALL_PHONE=
PHARMACY_CALL_NAME=Farmácia de teste
# Demo run button (/family/demo): reminder, call and family alert in about two minutes. Set to false to turn it off.
DEMO_RUN_ENABLED=true
# On boot, set the demo family to its fixed story (3 medicines, times, stock, a week of history).
DEMO_SEED_ENABLED=true
# Scheduled doses of the demo family also call its phone. false: only the demo run button calls.
DEMO_SCHEDULED_CALLS=false
# Seconds a demo run holds the button: a second press in this time follows the same run.
DEMO_RUN_LOCK_SECONDS=240
DEMO_CALL_AFTER_SECONDS=20
DEMO_ALERT_AFTER_SECONDS=100
# Days of pills left that trigger the "remédio acabando" alert to the family.
LOW_STOCK_DAYS=5
# Prescription reading (packages/prescription-reader).
ANTHROPIC_API_KEY=
# Claude model that reads prescriptions. Empty uses the reader's default (claude-opus-5-5).
PRESCRIPTION_MODEL=
# POST /prescriptions/parse is open and each read costs about US$ 0.06.
# Reads allowed in 24 hours per IP, per family and in total. 0 turns a limit off; PRESCRIPTION_LIMIT_TOTAL=0 turns reading off.
PRESCRIPTION_LIMIT_PER_IP=10
PRESCRIPTION_LIMIT_PER_FAMILY=10
PRESCRIPTION_LIMIT_TOTAL=100
# Requests per minute from one IP, on every route except health and the voice callbacks. 0 turns it off.
RATE_LIMIT_PER_MINUTE=300
# Reverse proxies in front of the API (Traefik in Coolify = 1). The client IP comes from X-Forwarded-For.
TRUST_PROXY_HOPS=1
# Web push. Generate with: npx web-push generate-vapid-keys
# The public key is the same value as NEXT_PUBLIC_VAPID_PUBLIC_KEY below.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services may use (mailto: or https: URL).
VAPID_SUBJECT=https://recuidado.com.br

# --- monitoring (PostHog: events, errors, logs, LLM traces) ---
# Project token (phc_...) of the PostHog project "Recuidado". Used by api and voice at runtime.
# Without it nothing is sent and logs only go to stdout.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# --- web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Build-time variable in Coolify. If empty, the web reads it from GET /push/public-key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Build-time variables in Coolify. Same token as POSTHOG_PROJECT_TOKEN.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- mcp (apps/mcp) ---
# Recuidado API the MCP tools call. In Coolify: https://api.recuidado.com.br (or the internal URL of recuidado/api).
API_URL=http://localhost:4000
# PORT defaults to 7000 in apps/mcp.

# --- data collection (packages/data) ---
FIRECRAWL_API_KEY=

# --- voice (apps/voice) and SIP bridge (deploy/asterisk) ---
# Full list in apps/voice/.env.example. Set on the Coolify resources recuidado/voice and recuidado/asterisk (see deploy/README.md):
OPENAI_API_KEY=
OPENAI_SIP_USERNAME=openai
OPENAI_SIP_PASSWORD=
SIP_DOMAIN=voz.recuidado.com.br
SIP_CALLER_NUMBER=
# Only numbers that may be called (the demo actor). Comma-separated.
# "*" allows any Brazilian number (public sign-ups); the API caps calls with CALL_DAILY_LIMIT_*.
CALL_ALLOWED_NUMBERS=
NVOIP_SIP_USER=
NVOIP_SIP_PASSWORD=
PUBLIC_IP=
