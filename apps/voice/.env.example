# Voice service (apps/voice). Secrets only through environment variables.

PORT=5000
# Shared secret between api and voice, sent as "Authorization: Bearer <token>" both ways
# (api -> POST /calls, voice -> POST /doses/:id/voice-result).
VOICE_API_TOKEN=

# OpenAI GPT-Live
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
# Responses model that records the patient's answer through the record_dose_answer tool.
OPENAI_DELEGATE_MODEL=gpt-6-luna

# SIP trunk GPT-Live dials through: the Asterisk bridge (infra/asterisk).
SIP_PROVIDER_URL=sips:voz.recuidado.com.br:5061
# Digest credentials GPT-Live uses on the bridge. Same values in the asterisk resource.
OPENAI_SIP_USERNAME=openai
OPENAI_SIP_PASSWORD=
# Caller number in E.164. The trunk may replace it with the account's own number.
SIP_CALLER_NUMBER=+5511999999999

# Comma-separated numbers this service is allowed to call (the demo actor's phone only).
CALL_ALLOWED_NUMBERS=
# Hard limit per call, in seconds.
CALL_MAX_SECONDS=150

# Where the result goes: POST {API_URL}/doses/:doseId/voice-result
API_URL=http://api:4000
