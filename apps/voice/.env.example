# Voice service (apps/voice). Secrets only through environment variables.

PORT=5000
# Shared secret between api and voice, sent as "Authorization: Bearer <token>" both ways
# (api -> POST /calls, voice -> POST /doses/:id/voice-result).
VOICE_API_TOKEN=

# OpenAI GPT-Live
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=bossa
# Responses model that records the patient's answer through the record_dose_answer tool.
OPENAI_DELEGATE_MODEL=gpt-6-luna
# Reasoning effort of the delegated model (empty = model default). Low records the answer faster.
OPENAI_DELEGATE_REASONING_EFFORT=low
# Where the greeting recorded on a first call is kept to be played instantly on later calls.
GREETING_CACHE_DIR=/data/greetings

# SIP trunk GPT-Live dials through: the Asterisk bridge (deploy/asterisk).
SIP_PROVIDER_URL=sips:voz.recuidado.com.br:5061
# Digest credentials GPT-Live uses on the bridge. Same values in the asterisk resource.
OPENAI_SIP_USERNAME=openai
OPENAI_SIP_PASSWORD=
# Caller number in E.164. The trunk may replace it with the account's own number.
SIP_CALLER_NUMBER=+5511999999999

# Comma-separated numbers this service is allowed to call (the demo actor's phone only).
# "*" allows any Brazilian number (public sign-ups); the API caps calls with CALL_DAILY_LIMIT_*.
CALL_ALLOWED_NUMBERS=
# Hard limit per call, in seconds.
CALL_MAX_SECONDS=150

# Where the result goes: POST {API_URL}/doses/:doseId/voice-result
API_URL=http://api:4000

# PostHog monitoring: call events, errors and logs. Same project token as the api.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Pharmacy calls. A second model classifies what the other side is doing (recorded menu, hold,
# person, "só um minuto", closed) from the live transcript, through GPT-Live Decisions. "off" uses
# only the word rules in pharmacy-call.ts.
PHARMACY_DECISIONS=on
# Voice of the attendant AI in the simulated pharmacies (+550000000001N, deploy/asterisk [sim-attendant]).
# Another voice than OPENAI_LIVE_VOICE, so the two sides of the call sound different.
PHARMACY_ACTOR_VOICE=tempo
# Voice of the simulated patient (sim-patient.ts); defaults to PHARMACY_ACTOR_VOICE.
PATIENT_ACTOR_VOICE=
# Asterisk Manager Interface (deploy/asterisk, AMI_SECRET there): mutes what the AI says to the
# pharmacy until the other side is classified as a person. Empty secret = never muted.
ASTERISK_AMI_SECRET=
# Default: this container's default gateway (the host, where Asterisk listens on 5038).
ASTERISK_AMI_HOST=
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=recuidado
# Record every call in Asterisk for the calls panel (needs the AMI above; Asterisk uploads to the API). on | off
RECORD_CALLS=on
