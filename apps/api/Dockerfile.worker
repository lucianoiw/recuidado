# The doses queue worker. Same source as the API (shared services), its own entrypoint, no HTTP.
# Build from the repo root: docker build -f apps/api/Dockerfile.worker .
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY packages/prescription-reader packages/prescription-reader
COPY packages/data packages/data
COPY packages/telemetry packages/telemetry
RUN pnpm install --frozen-lockfile --filter @recuidado/api...
COPY apps/api apps/api
RUN pnpm --filter @recuidado/api build \
  && pnpm deploy --filter @recuidado/api --prod --legacy /out \
  && cp -r apps/api/dist /out/

FROM node:22-alpine
ENV NODE_ENV=production TELEMETRY_SERVICE=worker
WORKDIR /app
COPY --from=build /out .
USER node
# Healthy while the heartbeat file is younger than 2 minutes.
HEALTHCHECK --interval=30s --timeout=5s CMD find /tmp/worker-heartbeat -mmin -2 | grep -q . || exit 1
CMD ["node", "dist/worker/main.js"]
